  {
    "name": "E10 /patient/chatbot/ is a dropped HTML page",
    "actor": "patient_asha",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/chatbot/",
        "headers": {
          "Accept": "text/html"
        }
      }
    ],
    "expected_differences": [
      {
        "step": 1,
        "kind": "status",
        "decision": "accepted",
        "reason": "chatbot.html dropped → 404"
      },
      {
        "step": 1,
        "kind": "body",
        "decision": "accepted",
        "reason": "template vs 404 page"
      },
      {
        "step": 1,
        "kind": "cookie:csrftoken",
        "decision": "accepted",
        "reason": "the dropped chatbot.html page set the CSRF cookie; React gets it from /csrf/"
      },
      {
        "step": 1,
        "kind": "cookie:sessionid",
        "decision": "accepted",
        "reason": "the dropped chatbot view re-saved the session"
      }
    ]
  }
