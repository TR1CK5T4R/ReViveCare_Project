        }
      },
      {
        "method": "POST",
        "path": "/patient/chatbot/send/",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Origin": "http://localhost:5173"
        },
        "body": "{\"message\": \"My knee feels warm [[reply:calm]]\", \"language\": \"english\"}",
        "compare_session": true,
        "compare_llm_request": true,
        "csrf": true,
        "compare_headers": ["vary", "access-control-allow-origin"]
      }
    ]
  },
