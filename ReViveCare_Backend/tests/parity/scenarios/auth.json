[
  {
    "name": "login with a known email (React flow: csrf, then form post)",
    "steps": [
      {
        "method": "GET",
        "path": "/csrf/"
      },
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "asha@parity.revivecare.test"
        },
        "compare_session": true,
        "compare_headers": [
          "vary"
        ]
      }
    ]
  },
  {
    "name": "login strips and lower-cases the email",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "  ASHA@Parity.Revivecare.TEST \t"
        },
        "compare_session": true
      }
    ]
  },
  {
    "name": "login ignores the password field",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "ravi@parity.revivecare.test",
          "password": "wrong"
        },
        "compare_session": true
      }
    ]
  },
  {
    "name": "login with an unknown email redirects home and creates no session",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "nobody@parity.revivecare.test"
        },
        "compare_session": true,
        "compare_headers": [
          "vary"
        ]
      }
    ]
  },
  {
    "name": "a mixed-case stored email can never log in",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "Mixed.Case@Parity.Revivecare.test"
        },
        "compare_session": true
      }
    ]
  },
  {
    "name": "login with a JSON body is treated as an empty email",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "json": {
          "email": "asha@parity.revivecare.test"
        },
        "compare_session": true
      }
    ]
  },
  {
    "name": "login with no body at all",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "compare_session": true
      }
    ]
  },
  {
    "name": "a second patient logging in on the same browser replaces the session data",
    "actor": "patient_asha",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "ravi@parity.revivecare.test"
        },
        "compare_session": true
      }
    ]
  },
  {
    "name": "a failed login keeps the existing session",
    "actor": "patient_asha",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "nobody@parity.revivecare.test"
        },
        "compare_session": true
      }
    ]
  },
  {
    "name": "GET /patient/logout/ flushes the session and deletes the cookie",
    "actor": "patient_asha",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/logout/",
        "compare_session": true,
        "compare_headers": [
          "vary"
        ]
      }
    ]
  },
  {
    "name": "GET /patient/logout/ without a session",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/logout/"
      }
    ]
  },
  {
    "name": "POST /patient/logout/ without CSRF is rejected and keeps the session",
    "actor": "patient_asha",
    "steps": [
      {
        "method": "POST",
        "path": "/patient/logout/",
        "compare_session": true
      }
    ]
  },
  {
    "name": "POST /patient/logout/ the way React sends it (cookie + X-CSRFToken + trusted Origin)",
    "steps": [
      {
        "method": "GET",
        "path": "/csrf/"
      },
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "asha@parity.revivecare.test"
        }
      },
      {
        "method": "POST",
        "path": "/patient/logout/",
        "csrf": true,
        "headers": {
          "Origin": "http://localhost:5173"
        },
        "compare_session": true
      }
    ]
  }
]
