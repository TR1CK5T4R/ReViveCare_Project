[
  {
    "name": "login with a known email (React flow: csrf, then form post)",
    "steps": [
      {
        "method": "GET",
        "path": "/csrf/"
      },
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "asha@parity.revivecare.test"
        },
        "compare_session": true,
        "compare_headers": ["vary"]
      }
    ]
  },
  {
    "name": "login strips and lower-cases the email",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "  ASHA@Parity.Revivecare.TEST \t"
        },
        "compare_session": true
      }
    ]
  },
  {
    "name": "login ignores the password field",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "ravi@parity.revivecare.test",
          "password": "wrong"
        },
        "compare_session": true
      }
    ]
  },
  {
    "name": "login with an unknown email redirects home and creates no session",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "nobody@parity.revivecare.test"
        },
        "compare_session": true,
        "compare_headers": ["vary"]
      }
    ]
  },
  {
    "name": "a mixed-case stored email can never log in",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "Mixed.Case@Parity.Revivecare.test"
        },
        "compare_session": true
      }
    ]
  },
  {
    "name": "login with a JSON body is treated as an empty email",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "json": {
          "email": "asha@parity.revivecare.test"
        },
        "compare_session": true
      }
    ]
  },
  {
    "name": "login with no body at all",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "compare_session": true
      }
    ]
  },
  {
    "name": "a second patient logging in on the same browser replaces the session data",
    "actor": "patient_asha",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "ravi@parity.revivecare.test"
        },
        "compare_session": true
      }
    ]
  },
  {
    "name": "a failed login keeps the existing session",
    "actor": "patient_asha",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "nobody@parity.revivecare.test"
        },
        "compare_session": true
      }
    ]
  },
  {
    "name": "GET /patient/logout/ flushes the session and deletes the cookie",
    "actor": "patient_asha",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/logout/",
        "compare_session": true,
        "compare_headers": ["vary"]
      }
    ]
  },
  {
    "name": "GET /patient/logout/ without a session",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/logout/"
      }
    ]
  },
  {
    "name": "POST /patient/logout/ without CSRF is rejected and keeps the session",
    "actor": "patient_asha",
    "steps": [
      {
        "method": "POST",
        "path": "/patient/logout/",
        "compare_session": true
      }
    ]
  },
  {
    "name": "POST /patient/logout/ the way React sends it (cookie + X-CSRFToken + trusted Origin)",
    "steps": [
      {
        "method": "GET",
        "path": "/csrf/"
      },
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "asha@parity.revivecare.test"
        }
      },
      {
        "method": "POST",
        "path": "/patient/logout/",
        "csrf": true,
        "headers": {
          "Origin": "http://localhost:5173"
        },
        "compare_session": true
      }
    ]
  },
  {
    "name": "POST /patient/logout/ from the server's own origin",
    "steps": [
      {
        "method": "GET",
        "path": "/csrf/"
      },
      {
        "method": "POST",
        "path": "/patient/logout/",
        "csrf": true,
        "headers": {
          "Origin": "{origin}"
        }
      }
    ]
  },
  {
    "name": "POST /patient/logout/ from an untrusted Origin is rejected even with a token",
    "steps": [
      {
        "method": "GET",
        "path": "/csrf/"
      },
      {
        "method": "POST",
        "path": "/patient/logout/",
        "csrf": true,
        "headers": {
          "Origin": "http://evil.test"
        }
      }
    ]
  },
  {
    "name": "POST /patient/logout/ with a wrong token is rejected",
    "steps": [
      {
        "method": "GET",
        "path": "/csrf/"
      },
      {
        "method": "POST",
        "path": "/patient/logout/",
        "headers": {
          "X-CSRFToken": "abcdefghijklmnopqrstuvwxyz012345"
        }
      }
    ]
  },
  {
    "name": "GET /csrf (no slash) redirects to /csrf/",
    "steps": [
      {
        "method": "GET",
        "path": "/csrf?x=1"
      }
    ]
  },
  {
    "name": "unknown paths are 404",
    "steps": [
      {
        "method": "GET",
        "path": "/no/such/page/"
      },
      {
        "method": "GET",
        "path": "/CSRF/"
      }
    ]
  },
  {
    "name": "a Host outside ALLOWED_HOSTS is rejected with 400",
    "steps": [
      {
        "method": "GET",
        "path": "/csrf/",
        "headers": {
          "Host": "evil.test"
        }
      }
    ]
  },
  {
    "name": "CORS: allowed origin on a simple request",
    "steps": [
      {
        "method": "GET",
        "path": "/csrf/",
        "headers": {
          "Origin": "http://localhost:5173"
        },
        "compare_headers": ["access-control-allow-origin", "access-control-allow-credentials"]
      }
    ]
  },
  {
    "name": "CORS: other origins get no CORS headers",
    "steps": [
      {
        "method": "GET",
        "path": "/csrf/",
        "headers": {
          "Origin": "http://evil.test"
        },
        "compare_headers": ["access-control-allow-origin", "access-control-allow-credentials"]
      }
    ]
  },
  {
    "name": "CORS: preflight for the logout POST",
    "steps": [
      {
        "method": "OPTIONS",
        "path": "/patient/logout/",
        "headers": {
          "Origin": "http://localhost:5173",
          "Access-Control-Request-Method": "POST",
          "Access-Control-Request-Headers": "content-type,x-csrftoken"
        },
        "compare_headers": [
          "access-control-allow-origin",
          "access-control-allow-credentials",
          "access-control-allow-methods",
          "access-control-allow-headers",
          "access-control-max-age"
        ]
      }
    ]
  },
  {
    "name": "GET /login/ (Django's HTML login form) is not served by Node",
    "steps": [
      {
        "method": "GET",
        "path": "/login/"
      }
    ],
    "expected_differences": [
      {
        "step": 0,
        "kind": "status",
        "decision": "accepted",
        "reason": "Django-rendered HTML pages are dropped; React has its own login page"
      },
      {
        "step": 0,
        "kind": "header:content-type",
        "decision": "accepted",
        "reason": "Django 200 HTML page vs Node 404 page"
      },
      {
        "step": 0,
        "kind": "cookie:csrftoken",
        "decision": "accepted",
        "reason": "the dropped template's {% csrf_token %} set the cookie"
      },
      {
        "step": 0,
        "kind": "body",
        "decision": "accepted",
        "reason": "Django's login_page.html vs Node's 404 page"
      }
    ]
  },
  {
    "name": "POST /login (no slash)",
    "steps": [
      {
        "method": "POST",
        "path": "/login",
        "form": {
          "email": "asha@parity.revivecare.test"
        }
      }
    ],
    "expected_differences": [
      {
        "step": 0,
        "kind": "status",
        "decision": "accepted",
        "reason": "the DEBUG=True reference raises RuntimeError (500); Node mirrors DEBUG=False, which answers 301 to /login/"
      },
      {
        "step": 0,
        "kind": "header:location",
        "decision": "accepted",
        "reason": "301 Location /login/ (DEBUG=False behaviour)"
      },
      {
        "step": 0,
        "kind": "header:content-type",
        "decision": "accepted",
        "reason": "500 debug page vs empty 301"
      }
    ]
  },
  {
    "name": "plain OPTIONS /login/ (not a preflight)",
    "steps": [
      {
        "method": "OPTIONS",
        "path": "/login/"
      }
    ],
    "expected_differences": [
      {
        "step": 0,
        "kind": "status",
        "decision": "accepted",
        "reason": "Django renders the dropped login_page.html for any non-POST method; Node 404"
      },
      {
        "step": 0,
        "kind": "header:content-type",
        "decision": "accepted",
        "reason": "Django 200 HTML page vs Node 404 page"
      },
      {
        "step": 0,
        "kind": "body",
        "decision": "accepted",
        "reason": "Django's login_page.html vs Node's 404 page"
      },
      {
        "step": 0,
        "kind": "cookie:csrftoken",
        "decision": "accepted",
        "reason": "the dropped template's {% csrf_token %} set the cookie"
      }
    ]
  },
  {
    "name": "login with a NUL byte in the email",
    "steps": [
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "asha\u0000@parity.revivecare.test"
        },
        "compare_session": true
      }
    ],
    "expected_differences": [
      {
        "step": 0,
        "kind": "status",
        "decision": "accepted",
        "reason": "Node mirrors Django on Postgres (500: text can't hold U+0000); the SQLite reference finds no patient (302 /)"
      },
      {
        "step": 0,
        "kind": "header:location",
        "decision": "accepted",
        "reason": "302 Location / on the SQLite reference vs Node's 500"
      },
      {
        "step": 0,
        "kind": "body",
        "decision": "accepted",
        "reason": "empty 302 body vs Django's 500 page"
      }
    ]
  }
]
