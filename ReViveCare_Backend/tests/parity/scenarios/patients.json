[
  {
    "name": "dashboard after login (React flow: csrf, login, JSON dashboard)",
    "steps": [
      {
        "method": "GET",
        "path": "/csrf/"
      },
      {
        "method": "POST",
        "path": "/login/",
        "form": {
          "email": "asha@parity.revivecare.test"
        }
      },
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "Origin": "http://localhost:5173"
        },
        "csrf": true,
        "compare_session": true,
        "compare_headers": ["vary", "access-control-allow-origin", "access-control-allow-credentials"]
      }
    ]
  },
  {
    "name": "dashboard shows the second patient their own record",
    "actor": "patient_ravi",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "headers": {
          "Accept": "application/json"
        },
        "compare_session": true
      }
    ]
  },
  {
    "name": "dashboard without a session: 401 JSON",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "compare_session": true,
        "compare_headers": ["vary"]
      }
    ]
  },
  {
    "name": "dashboard JSON mode from Content-Type alone",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "headers": {
          "Content-Type": "application/json"
        }
      }
    ]
  },
  {
    "name": "dashboard JSON mode from an Accept list that contains application/json",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "headers": {
          "Accept": "text/html, application/json;q=0.9"
        }
      }
    ]
  },
  {
    "name": "Content-Type with a charset is not JSON mode (exact match)",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        }
      }
    ]
  },
  {
    "name": "upper-case Accept is not JSON mode (case-sensitive substring)",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "headers": {
          "Accept": "Application/JSON"
        }
      }
    ]
  },
  {
    "name": "HTML mode without a session redirects to /login/",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "headers": {
          "Accept": "text/html"
        },
        "compare_session": true,
        "compare_headers": ["vary"]
      }
    ]
  },
  {
    "name": "HTML mode while logged in: Django renders the dropped template",
    "actor": "patient_asha",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "headers": {
          "Accept": "text/html"
        }
      }
    ],
    "expected_differences": [
      {
        "step": 1,
        "kind": "status",
        "decision": "accepted",
        "reason": "patient_dashboard.html is dropped; Node answers 404 (redirects of HTML mode are kept)"
      },
      {
        "step": 1,
        "kind": "body",
        "decision": "accepted",
        "reason": "Django template HTML vs Django's 404 page"
      }
    ]
  },
  {
    "name": "dashboard after the patient row was deleted: 404 JSON, then HTML mode redirects",
    "actor": "patient_gone",
    "steps": [
      {
        "action": "delete_patient",
        "email": "gone@parity.revivecare.test"
      },
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "compare_session": true,
        "compare_headers": ["vary"]
      },
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "compare_session": true
      }
    ]
  },
  {
    "name": "POST to the dashboard needs no CSRF token (@csrf_exempt) and ignores the body",
    "actor": "patient_asha",
    "steps": [
      {
        "method": "POST",
        "path": "/patient/dashboard/?id=1",
        "headers": {
          "Accept": "application/json",
          "Origin": "http://evil.example"
        },
        "body": "{not json"
      }
    ]
  },
  {
    "name": "HEAD and plain OPTIONS reach the dashboard view",
    "actor": "patient_asha",
    "steps": [
      {
        "method": "HEAD",
        "path": "/patient/dashboard/",
        "headers": {
          "Accept": "application/json"
        }
      },
      {
        "method": "OPTIONS",
        "path": "/patient/dashboard/",
        "headers": {
          "Accept": "application/json"
        }
      }
    ]
  },
  {
    "name": "dashboard after logout is 401",
    "actor": "patient_asha",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/logout/"
      },
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "headers": {
          "Accept": "application/json"
        }
      }
    ]
  },
  {
    "name": "APPEND_SLASH: /patient/dashboard redirects to the slash URL",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/dashboard?x=1"
      }
    ]
  },
  {
    "name": "trailing whitespace in Content-Type",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "headers": {
          "Content-Type": "application/json "
        }
      }
    ],
    "expected_differences": [
      {
        "step": 0,
        "kind": "status",
        "decision": "accepted",
        "reason": "Node's HTTP parser strips trailing whitespace from header values (RFC 9110 OWS), so Node sees exactly application/json (JSON mode, 401); Django's dev server keeps the space (HTML mode, 302)"
      },
      {
        "step": 0,
        "kind": "header:location",
        "decision": "accepted",
        "reason": "302 Location /login/ vs no redirect"
      },
      {
        "step": 0,
        "kind": "header:content-type",
        "decision": "accepted",
        "reason": "redirect vs JSON response"
      },
      {
        "step": 0,
        "kind": "body",
        "decision": "accepted",
        "reason": "empty redirect body vs the 401 JSON body"
      }
    ]
  },
  {
    "name": "dashboard with an unknown session cookie deletes it (JSON mode)",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "headers": {
          "Accept": "application/json",
          "Cookie": "sessionid=abcdefghijklmnopqrstuvwxyz012345"
        },
        "compare_headers": ["vary"]
      }
    ]
  },
  {
    "name": "dashboard with an unknown session cookie deletes it (HTML mode)",
    "steps": [
      {
        "method": "GET",
        "path": "/patient/dashboard/",
        "headers": {
          "Cookie": "sessionid=abcdefghijklmnopqrstuvwxyz012345"
        }
      }
    ]
  },
  {
    "name": "a too-short session cookie on a view that never reads the session",
    "steps": [
      {
        "method": "GET",
        "path": "/csrf/",
        "headers": {
          "Cookie": "sessionid=abc"
        }
      }
    ],
    "expected_differences": [
      {
        "step": 0,
        "kind": "cookie:sessionid",
        "decision": "accepted",
        "reason": "item 17: Django deletes a session cookie shorter than 8 characters on every response; Node only where a view reads the session"
      }
    ]
  }
]
