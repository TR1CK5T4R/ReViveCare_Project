# =============================================================================
# ReviveCare Node backend — environment variables
#
# Copy to .env and fill in real values. Every variable is validated at startup
# by src/config/env.js; a missing or invalid one stops the server with its name.
# Names shared with the Django backend keep Django's spelling.
# Placeholder values below are examples, never real secrets.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
# development | test | production. production turns on Secure session cookies and HSTS.
NODE_ENV=development
# HTTP port. (Django ran on 8000; the Vite dev proxy targets 127.0.0.1:8000.)
PORT=3000
# Express "trust proxy": false | true | hop count (e.g. 1) | comma list of proxy IPs.
# Set it when running behind a hosting proxy/load balancer, otherwise Secure
# cookies are not sent and rate limiting sees the proxy's IP.
TRUST_PROXY=false
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs (needs the pino-pretty dev dependency). Default: on in development.
LOG_PRETTY=

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Keep these in this folder's .env only: a DATABASE_URL in a .env that Django
# can see switches Django from SQLite to Postgres (settings.py:100).
# Day-to-day development database (npm run dev, db:migrate, seed, etl).
DATABASE_URL=postgresql://revivecare:PASSWORD@localhost:5432/revivecare_dev
# Automated tests (npm test). Rebuilt from the migrations on every run.
TEST_DATABASE_URL=postgresql://revivecare:PASSWORD@localhost:5432/revivecare_test
# Parity runs and index benchmarks (npm run parity / bench). Reset often.
PARITY_DATABASE_URL=postgresql://revivecare:PASSWORD@localhost:5432/revivecare_parity
# Optional pool tuning (defaults shown).
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# ── Sessions and CSRF ────────────────────────────────────────────────────────
# Signs the `sessionid` cookie. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional: force the session cookie's Secure flag (Django: SESSION_COOKIE_SECURE = not DEBUG).
# Default: true in production, false otherwise.
SESSION_COOKIE_SECURE=
# Signs CSRF tokens (the `csrftoken` cookie). At least 32 random characters, different from SESSION_SECRET.
CSRF_SECRET=replace-with-another-32-plus-random-characters

# ── Hosts and origins (same names and defaults as Django settings.py) ───────
# Comma-separated, no spaces. Host names this server answers to; '.example.com'
# also matches subdomains. Requests with another Host header get 400.
ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origins allowed to call the API with cookies (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173
# Origins allowed to send CSRF-protected POSTs (e.g. logout).
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# ── Login rate limit ──────────────────────────────
# Failed POST /login/ attempts allowed per client IP per window.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ── AI chat (used from Phase 6) ──────────────────────────────────────────────
# Groq API key (same variable as Django).
GROQ_API_KEY=gsk_your_key_here
# Optional: another base URL for the Groq API (parity runs point it at a local mock).
# Leave unset in normal use.
GROQ_BASE_URL=
# Chat messages per patient per window (default 20 per 60 s). Each one is a paid LLM call.
CHAT_RATE_LIMIT_MAX=20
CHAT_RATE_LIMIT_WINDOW_MS=60000

# ── Doctor alert e-mail (used from Phase 6; Django names) ────────────────────
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
EMAIL_SENDER=alerts@example.com
# App password for EMAIL_SENDER (never your normal account password).
EMAIL_PASSWORD=app-password-here
# Who receives seriousness > 0.75 alerts.
DOCTOR_EMAIL=doctor@example.com

# ── Doctor alert phone call via Twilio (used from Phase 6, optional) ────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Your Twilio number (caller).
TWILIO_PHONE_NUMBER=+10000000000
# The doctor's verified number (callee).
TO_NUMBER=+910000000000

# ── Scripts only ─────────────────────────────────────────────────────────────
# Password given to every seeded user by scripts/seed.js (dev/test/parity DBs only).
SEED_USER_PASSWORD=choose-a-dev-password
