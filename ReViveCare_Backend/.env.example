# =============================================================================
# ReviveCare Node backend — environment variables
#
# Copy to .env and fill in real values. Every variable is validated at startup
# by src/config/env.js; a missing or invalid one stops the server with its name.
# Names shared with the Django backend keep Django's spelling.
# Placeholder values below are examples, never real secrets.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
# development | test | production. production turns on Secure session cookies and HSTS.
NODE_ENV=development
# HTTP port. (Django ran on 8000; the Vite dev proxy targets 127.0.0.1:8000.)
PORT=3000
# Express "trust proxy": false | true | hop count (e.g. 1) | comma list of proxy IPs.
# Set it when running behind a hosting proxy/load balancer, otherwise Secure
# cookies are not sent and rate limiting sees the proxy's IP.
TRUST_PROXY=false
# pino level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable logs (needs the pino-pretty dev dependency). Default: on in development.
LOG_PRETTY=

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Keep these in this folder's .env only: a DATABASE_URL in a .env that Django
# can see switches Django from SQLite to Postgres (settings.py:100).
# Day-to-day development database (npm run dev, db:migrate, seed, etl).
DATABASE_URL=postgresql://revivecare:PASSWORD@localhost:5432/revivecare_dev
# Automated tests (npm test). Rebuilt from the migrations on every run.
TEST_DATABASE_URL=postgresql://revivecare:PASSWORD@localhost:5432/revivecare_test
# Parity runs and index benchmarks (npm run parity / bench). Reset often.
PARITY_DATABASE_URL=postgresql://revivecare:PASSWORD@localhost:5432/revivecare_parity
# Optional pool tuning (defaults shown).
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
