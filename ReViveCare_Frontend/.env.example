# Copy to .env (never commit .env). All values are optional in development.

# Leave unset in development: API calls go to the same origin and the Vite
# proxy forwards them to the backend. Set it to the API's URL only for a build
# served from a different origin (e.g. https://api.example.com; no trailing slash).
VITE_API_BASE_URL=

# Where the Vite dev proxy sends API calls. Default: http://127.0.0.1:3000 (Node).
VITE_PROXY_TARGET=
